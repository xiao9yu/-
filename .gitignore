backend/.env
# 未配置 SECRET_KEY 时自动生成的本地 JWT 密钥（每机一份，不入库）
.secret_key
backend/.secret_key
backend/uploads/
backend/data/
# 本地运行期产生的 SQLite 数据库（含会话/消息），不入库
backend/*.db
backend/*.db-journal
backend/*.db-wal
__pycache__/
*.pyc
node_modules/
frontend/dist/
.DS_Store
.superpowers/
# 本地运行日志（uvicorn/vite 重定向产物）与进程清理记录
backend/*.log
frontend/*.log
backend/kill_result.txt
